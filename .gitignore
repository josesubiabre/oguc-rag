# Bandeja de entrada y archivo: no son corpus. Se conserva la carpeta para
# que la estructura sobreviva a un clon, pero no su contenido — las versiones
# superadas ya quedan en el historial de git.
data/00_inbox/*
!data/00_inbox/.gitkeep
data/90_archive/*
!data/90_archive/.gitkeep
